    {
      "parameters": {
        "jsCode": "//MANEJO ABREVIADO DE JSON\nconst lista = $json.datos;\n\n// FUNCIÓN FLECHA\n// Forma tradicional\nfunction doble(x) {\n  return x * 2;\n}\n// Forma flecha equivalente\nconst dobleFlecha = x => x * 2;\n\n// MAP (transformar datos)\n// map es un método de los arrays que recorre todos los elementos y crea un nuevo array transformado\nconst nombres = lista.map(item => ({\n  nombre: item.Nombre,\n  mayor: item.Edad >= 18\n}));\n\n// REDUCE (acumular valores)\n// reduce es un método de los arrays que recorre todos los elementos y los combina en un único resultado.\n\nconst sumaPromedios = lista.reduce(\n  (acum, item) => acum + item.Promedio,\n  0\n);\n\n// DESTRUCTURING (extraer variables)\nconst ejemplo = lista[0];\nconst { Nombre, Edad } = ejemplo;\n\n// SPREAD (copiar y modificar objetos)\nconst copia = {\n  ...ejemplo,\n  Nombre: ejemplo.Nombre.toUpperCase()\n};\n\n// CREAR NUEVO JSON LIMPIO\nconst transformado = lista.map(item => ({\n  nombre: item.Nombre,\n  edad: item.Edad\n}));\n\n// CADENA DE OPERACIONES\nconst resultado = lista\n  .filter(item => item.Edad >= 18)\n  .map(item => ({\n    nombre: item.Nombre,\n    promedio: item.Promedio\n  }));\n\nreturn [\n  {\n    json: {\n      ejemplo_funcion: doble(5),\n      ejemplo_flecha: dobleFlecha(5),\n      nombres: nombres,\n      suma_promedios: sumaPromedios,\n      destructuring: { Nombre, Edad },\n      copia: copia,\n      transformado: transformado,\n      resultado_final: resultado\n    }\n  }\n];"
      },
