    {
      "parameters": {
        "jsCode": "// Tomar el arreglo que viene desde Edit Fields\nconst lista = $json.datos;\nlet resultado = [];\n\n// Recorrer cada registro\nfor (let i = 0; i < lista.length; i++) {\n  // Copiar el registro actual\n  let estudiante = { ...lista[i] };\n  //ACTUALIZAR / AGREGAR CAMPOS NUEVOS\n  estudiante.Estado = \"Revisado\";\n  estudiante.Anio = 2026;\n  \n  //MODIFICAR CAMPOS EXISTENTES\n  estudiante.Nombre = estudiante.Nombre.toUpperCase();\n  estudiante.Programa = \"Programa de \" + estudiante.Programa;\n\n  // Cambiar Activo de booleano a texto\n  if (estudiante.Activo === true) {\n    estudiante.Activo = \"Si\";\n  } else {\n    estudiante.Activo = \"No\";\n  }\n\n  // ELIMINAR CAMPOS\n  delete estudiante.Hobbies;\n\n  // FILTRAR REGISTROS\n  if (estudiante.Edad >= 18 && estudiante.Promedio >= 4.0) {\n    resultado.push({\n      json: estudiante\n    });\n  }\n}\n\nreturn resultado;"
      },
